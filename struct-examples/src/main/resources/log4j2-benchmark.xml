<!--
  专供 benchmark 任务使用（见 build.gradle 的 -Dlog4j2.configurationFile）。
  examples 默认的 log4j2.xml 把 org.struct 设成 DEBUG 并输出到控制台，
  在基准跑动时会淹没 JMH 的结果块，这里把它们全部关掉。
-->
<Configuration status="OFF">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_ERR">
            <PatternLayout pattern="[%level] %logger{35} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="OFF"/>
    </Loggers>
</Configuration>
